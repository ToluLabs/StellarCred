{
  "name": "@stellarcred/sdk",
  "version": "0.1.1",
  "description": "Read-only client for StellarCred \u2014 check ZK credential proofs on Stellar from any protocol, frontend, or backend.",
  "license": "MIT",
  "author": "Samuel Dahunsi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ToluLabs/StellarCred.git",
    "directory": "frontend/packages/sdk"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "stellar",
    "soroban",
    "zk",
    "credentials",
    "identity",
    "web3"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./dist/index.mjs",
      "edge-light": "./dist/index.mjs",
      "workerd": "./dist/index.mjs",
      "browser": "./dist/index.mjs",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.mjs"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "bun": "./dist/server.mjs",
      "edge-light": "./dist/server.mjs",
      "workerd": "./dist/server.mjs",
      "browser": "./dist/server.mjs",
      "import": "./dist/server.mjs",
 feat/universal-wasm-packaging
      "require": "./dist/server.js",
      "default": "./dist/server.mjs"
    },
    "./wasm": {
      "types": "./dist/wasm/index.d.ts",
      "browser": {
        "import": "./dist/wasm/browser.mjs",
        "require": "./dist/wasm/browser.js",
        "default": "./dist/wasm/browser.mjs"
      },
      "edge-light": {
        "import": "./dist/wasm/browser.mjs",
        "default": "./dist/wasm/browser.mjs"
      },
      "workerd": {
        "import": "./dist/wasm/browser.mjs",
        "default": "./dist/wasm/browser.mjs"
      },
      "bun": {
        "import": "./dist/wasm/node.mjs",
        "require": "./dist/wasm/node.js",
        "default": "./dist/wasm/node.mjs"
      },
      "node": {
        "import": "./dist/wasm/node.mjs",
        "require": "./dist/wasm/node.js",
        "default": "./dist/wasm/node.mjs"
      },
      "import": "./dist/wasm/index.mjs",
      "require": "./dist/wasm/index.js",
      "default": "./dist/wasm/index.mjs"

      "require": "./dist/server.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.mjs",
      "require": "./dist/testing.js"
 main
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
 feat/universal-wasm-packaging
    "build": "tsup",

    "build": "tsup src/index.ts src/server.ts src/testing.ts --format cjs,esm --dts --clean",
 main
    "test": "vitest run",
    "test:integration": "vitest run test/integration.test.ts",
    "test:retry": "vitest run src/submit-retry.test.ts",
    "typecheck": "tsc --noEmit",
    "docs:api": "node scripts/build-docs.mjs",
    "lint": "eslint src test",
    "format:check": "prettier --check src test",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "@stellar/stellar-sdk": ">=13.0.0"
  },
  "peerDependenciesMeta": {
    "@stellar/stellar-sdk": {
      "optional": false
    }
  },
  "devDependencies": {
    "@stellar/stellar-sdk": "^13.3.0",
    "@types/node": "^20",
    "tsup": "^8.5.1",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3",
    "vitest": "^3.1.1"
  },
  "dependencies": {
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "@scure/bip39": "^1.6.0",
    "issuer-registry": "link:../issuer-registry",
    "proof-registry": "link:../proof-registry"
  }
}
