{
  "name": "@stellarcred/sdk",
  "version": "0.1.1",
  "description": "Read-only client for StellarCred \u2014 check ZK credential proofs on Stellar from any protocol, frontend, or backend.",
  "license": "MIT",
  "author": "Samuel Dahunsi",
  "repository": {
    "type": "git",
    "url": "https://github.com/Psalmuel01/StellarCred",
    "directory": "frontend/packages/sdk"
  },
  "keywords": [
    "stellar",
    "soroban",
    "zk",
    "credentials",
    "identity",
    "web3"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "test": "tsx --test src/index.test.ts",
    "test": "vitest run",
    "test:integration": "vitest run test/integration.test.ts",
    "typecheck": "tsc --noEmit",
    "docs:api": "typedoc",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "@stellar/stellar-sdk": ">=13.0.0"
  },
  "peerDependenciesMeta": {
    "@stellar/stellar-sdk": {
      "optional": false
    }
  },
  "devDependencies": {
    "@stellar/stellar-sdk": "^13.3.0",
    "@types/node": "^20",
    "tsup": "^8.5.1",
    "tsx": "^4.19.2",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3",
    "vitest": "^3.1.1"
  },
  "dependencies": {
    "issuer-registry": "link:../issuer-registry",
    "proof-registry": "link:../proof-registry"
  }
}
