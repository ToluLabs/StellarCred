{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm start --port 4319",
      "startServerReadyPattern": "Ready in",
      "startServerReadyTimeout": 60000,
      "url": [
        "http://localhost:4319/",
        "http://localhost:4319/apps",
        "http://localhost:4319/holder",
        "http://localhost:4319/issuer",
        "http://localhost:4319/verify",
        "http://localhost:4319/docs"
      ],
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop",
        "skipAudits": [
          "uses-http2",
          "uses-long-cache-ttl",
          "canonical",
          "robots-txt"
        ]
      }
    },
    "assert": {
      "assertions": {
        "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
        "total-blocking-time": ["error", { "maxNumericValue": 300 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
        "total-byte-weight": ["error", { "maxNumericValue": 1500000 }],
        "resource-summary:script:size": ["error", { "maxNumericValue": 800000 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}