# =============================================================================
# StellarCred Frontend Environment Configuration
# =============================================================================
# NOTE: This file documents variables used by the Next.js frontend.
#
# For root-level services (indexer, scripts), see ../.env.example — that file
# documents variables used by the root-level TypeScript services.
#
# Do not let these two files drift: if you add a new env var to one source
# tree, add it to the corresponding .env.example file.
# =============================================================================
# Copy to .env.local (or .env for non-secret values) and fill in as needed.
#
# Legend:
#   [REQUIRED]  - Must be set for the application to start
#   [OPTIONAL]  - Can be left blank; app uses safe defaults or mock mode
#   [SERVER]    - Server-only; never prefix with NEXT_PUBLIC_
#   [PUBLIC]    - Safe for client; must have NEXT_PUBLIC_ prefix
#
# Note: Empty values (KEY=) are treated as unset for optional variables.
# =============================================================================

# -----------------------------------------------------------------------------
# Stellar network
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# [PUBLIC]  Soroban RPC endpoint — alternative name used by /api/ready.
# Equivalent to NEXT_PUBLIC_RPC_URL; set either or both.
NEXT_PUBLIC_SOROBAN_RPC_URL=

# [SERVER]  Server-only Soroban RPC endpoint — used by /api/ready when the
# public var is not set. Leave blank to fall back to NEXT_PUBLIC_SOROBAN_RPC_URL.
SOROBAN_RPC_URL=

# App versioning
NEXT_PUBLIC_APP_VERSION=1.0.0

# -----------------------------------------------------------------------------
# Issuer Configuration
# -----------------------------------------------------------------------------

NEXT_PUBLIC_ISSUER_ADDRESS=
NEXT_PUBLIC_ISSUER_NAMES=
NEXT_PUBLIC_STELLARCRED_BASE_URL=https://stellarcred.xyz
NEXT_PUBLIC_APP_URL=

# -----------------------------------------------------------------------------
# Indexer Service
# -----------------------------------------------------------------------------
# [OPTIONAL] [SERVER] Base URL of the services/indexer HTTP API (see
# ../.env.example). Used by /api/issuer-stats to surface per-issuer
# reputation stats (issued count, active/revoked, credential types,
# first-seen date) on the issuer page. Defaults to http://localhost:3001
# (the indexer's own default PORT) when unset.

INDEXER_URL=

# -----------------------------------------------------------------------------
# WalletConnect
# -----------------------------------------------------------------------------

NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# -----------------------------------------------------------------------------
# Issuer Signing Key
# -----------------------------------------------------------------------------

ISSUER_PRIVATE_KEY=
ISSUER_SECRET_KEY=
SIGNER_SECRET_KEY=

# -----------------------------------------------------------------------------
# Deployed Contract IDs
# -----------------------------------------------------------------------------

NEXT_PUBLIC_ISSUER_REGISTRY_ID=
NEXT_PUBLIC_CREDENTIAL_VERIFIER_ID=
NEXT_PUBLIC_PROOF_REGISTRY_ID=
PROOF_REGISTRY_ID=
NEXT_PUBLIC_PROOF_REGISTRY_CONTRACT_ID=
PROOF_REGISTRY_CONTRACT_ID=
NEXT_PUBLIC_GATED_POOL_ID=

# [PUBLIC]  Alternative proof registry contract ID name used by /api/ready.
NEXT_PUBLIC_PROOF_REGISTRY_CONTRACT_ID=

# [SERVER]  Server-only proof registry contract ID used by /api/ready when
# the public var is not set.
PROOF_REGISTRY_CONTRACT_ID=

# -----------------------------------------------------------------------------
# StellarCred SDK Configuration
# -----------------------------------------------------------------------------

STELLARCRED_REGISTRY_ID=
STELLARCRED_RPC_URL=

# [OPTIONAL] Opt-in indexer fast path for SDK claim reads (#613). Unset = the
# SDK reads exclusively from the ProofRegistry contract on-chain. Setting a URL
# does NOT change any default — callers must still pass source: "indexer" or
# source: "indexer-verified" per call. Indexer reads are a cache of public chain
# data served by an operator you trust; they must never be the sole basis for a
# security decision. Gate-critical checks should use "chain" (the default) or
# "indexer-verified", which returns the chain result and warns on drift.
# See packages/sdk/README.md ("Indexer fast path").
STELLARCRED_INDEXER_URL=

# [OPTIONAL] [PUBLIC] Browser-visible alias for STELLARCRED_INDEXER_URL, for
# frontends that read claims client-side. STELLARCRED_INDEXER_URL wins when both
# are set. Safe to publish — it is only an endpoint URL.
NEXT_PUBLIC_INDEXER_URL=

# [OPTIONAL] [SERVER] Bearer token for an indexer that requires auth. Deliberately
# has NO NEXT_PUBLIC_ alias: it is a secret and must never be bundled for the
# browser. The SDK warns in development if it is set in a browser context.
STELLARCRED_INDEXER_API_KEY=

# -----------------------------------------------------------------------------
# Persona KYC (Identity Verification)
# -----------------------------------------------------------------------------

PERSONA_API_KEY=
PERSONA_KYC_TEMPLATE_ID=
PERSONA_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Plaid Balance Attestation
# -----------------------------------------------------------------------------

PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ACCESS_TOKEN=

# [OPTIONAL] Comma-separated additional access tokens. Aggregate proof-of-funds:
# balances from every linked item (PLAID_ACCESS_TOKEN + PLAID_ACCESS_TOKENS) are
# summed server-side and only the total is attested. Max 25 items.
PLAID_ACCESS_TOKENS=

PLAID_ENV=sandbox

# -----------------------------------------------------------------------------
# Sponsored / Gasless Submission
# -----------------------------------------------------------------------------

# [PUBLIC] Sponsor account that pays network fees for holders.
# When set, the holder page offers "Submit without XLM". Leave blank to disable.
NEXT_PUBLIC_SPONSOR_ACCOUNT_ID=

# [SERVER] Secret key for the sponsor account. Never prefix with NEXT_PUBLIC_
# and never commit this value. Only required when the relay is active.
SPONSOR_SECRET=

# -----------------------------------------------------------------------------
# Shared Key-Value Store (Rate Limiting & Idempotency)
# -----------------------------------------------------------------------------
# [OPTIONAL] [SERVER] REST endpoint and bearer token for Upstash Redis or Vercel KV.
# When configured, rate limiting and idempotency use this distributed store instead
# of the in-process Map, ensuring enforcement across multi-instance, serverless,
# and horizontally scaled deployments (Vercel, AWS Lambda, Cloud Run, etc.).
# If unset in a multi-instance/serverless environment, a warning is logged and
# in-process Map fallback is used.
#
# Upstash Redis:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
#
# Or Vercel KV aliases:
KV_REST_API_URL=
KV_REST_API_TOKEN=

# -----------------------------------------------------------------------------
# Operations & Monitoring
# -----------------------------------------------------------------------------

LOG_LEVEL=info
APP_ORIGIN=
IDEMPOTENCY_TTL_SECONDS=86400

# [OPTIONAL][SERVER] Hard cap on in-process idempotency cache entries.
# When the store exceeds this, oldest-first eviction runs to keep memory
# bounded under a flood of distinct Idempotency-Key values.
# Default: 10000
IDEMPOTENCY_MAX_ENTRIES=10000

# [OPTIONAL][SERVER] Hard cap on in-process rate-limit buckets.
# When the store exceeds this, oldest-first eviction runs to keep memory
# bounded under a flood of distinct source keys (IPs, wallets).
# Default: 10000
RATE_LIMIT_MAX_BUCKETS=10000

# [OPTIONAL][SERVER] Webhook URL for reporting unexpected 500 errors to an
# external sink (e.g. Sentry). Off when unset — no errors are forwarded. No PII
# is sent. Leave blank to disable.
ERROR_REPORTING_WEBHOOK=

# [OPTIONAL][SERVER] File path for the hash-chained, PII-free issuance audit
# log (JSON-lines, one entry per issuance). Defaults to .data/audit-log.jsonl
# under the frontend directory. Verify integrity with: pnpm verify:audit-log.
# See docs/audit-log.md. Unset = default location.
AUDIT_LOG_PATH=

# -----------------------------------------------------------------------------
# Development & Testing
# -----------------------------------------------------------------------------

# Production origin for CORS on /api/* routes — set to your deployed app URL
# (e.g. https://stellarcred.xyz). Falls back to http://localhost:3000 in dev
# if unset; must be set correctly in production or CORS will be ineffective.
APP_ORIGIN=

# Mock balance used when no Plaid access token is configured
PLAID_MOCK_BALANCE=50000

PORT=4100
ANALYZE=false
PLAYWRIGHT_BASE_URL=
CI=false