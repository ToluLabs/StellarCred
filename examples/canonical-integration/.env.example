# ==============================================================================
# StellarCred Canonical Integration Example - Environment Configuration
# ==============================================================================

# ProofRegistry Contract ID (Stellar Testnet)
# Authoritative testnet deployment from DEPLOYMENTS.md
STELLARCRED_REGISTRY_ID=CBEXHUMCNS4TJWNYXRFJNIWCNUW62MHAXL4JOBT764CLMHAPNJKIRWXV

# Soroban RPC URL (Stellar Testnet)
STELLARCRED_RPC_URL=https://soroban-testnet.stellar.org

# Stellar Network Passphrase
STELLARCRED_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# StellarCred Hosted Web App URL (for redirecting holders to verify credentials)
# In production, defaults to https://stellarcred.xyz
STELLARCRED_BASE_URL=https://stellarcred.xyz

# Local Application Settings
PORT=3000
APP_DOMAIN=localhost:3000

# Optional: Comma-separated list of trusted issuer public keys (G...)
# Leave blank to accept credentials from any registered issuer in the IssuerRegistry
TRUSTED_ISSUERS=
