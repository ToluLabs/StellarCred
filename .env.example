# =============================================================================
# StellarCred Environment Configuration
# =============================================================================
# Copy to .env.local (or .env for non-secret values) and fill in as needed.
#
# Legend:
#   [REQUIRED]  - Must be set for the application to start
#   [OPTIONAL]  - Can be left blank; app uses safe defaults or mock mode
#   [SERVER]    - Server-only; never prefix with NEXT_PUBLIC_
#   [PUBLIC]    - Safe for client; must have NEXT_PUBLIC_ prefix
#
# Note: Empty values (KEY=) are treated as unset for optional variables.
# =============================================================================

# -----------------------------------------------------------------------------
# Stellar Network
# -----------------------------------------------------------------------------

# [PUBLIC] Stellar network to connect to
# Options: testnet | mainnet | futurenet | standalone
# Default: testnet
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# [PUBLIC] Soroban RPC endpoint URL
# Default: https://soroban-testnet.stellar.org
NEXT_PUBLIC_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# [PUBLIC] Stellar network passphrase
# Default: Test SDF Network ; September 2015
NEXT_PUBLIC_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# -----------------------------------------------------------------------------
# Issuer Configuration
# -----------------------------------------------------------------------------

# [PUBLIC] [OPTIONAL] Registered issuer's Stellar address 
# (the public side of ISSUER_PRIVATE_KEY)
# Format: 56-character address starting with 'G'
# Leave blank to disable demo pre-selection in dropdowns
NEXT_PUBLIC_ISSUER_ADDRESS=

# [PUBLIC] [OPTIONAL] JSON map of issuer address → display name for /issuer dropdown
# On-chain metadata (set via set_issuer_metadata) is preferred when available;
# this env var serves as a fallback for issuers without on-chain metadata.
NEXT_PUBLIC_ISSUER_NAMES=

# [PUBLIC] [OPTIONAL] Base URL the SDK uses when building verify links (buildVerifyUrl),
# and the dapp metadata URL/icon WalletConnect shows in the wallet's pairing prompt.
# Leave blank to auto-detect from request origin
NEXT_PUBLIC_STELLARCRED_BASE_URL=https://stellarcred.xyz

# [PUBLIC] [OPTIONAL] Application URL for wallet redirects and callbacks
NEXT_PUBLIC_APP_URL=

# -----------------------------------------------------------------------------
# WalletConnect
# -----------------------------------------------------------------------------

# [PUBLIC] [OPTIONAL] WalletConnect project ID (free, from https://cloud.reown.com)
# Enables WalletConnect as a wallet option. Freighter/Albedo/xBull/Rabet/Lobstr/Hana
# work via the Stellar Wallets Kit without this; unset = WalletConnect is
# omitted from the wallet-picker, everything else still works.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# -----------------------------------------------------------------------------
# Issuer Signing Key
# -----------------------------------------------------------------------------

# [SERVER] [OPTIONAL] Issuer signing key — SERVER ONLY, never prefixed NEXT_PUBLIC_.
# 64-char hex secp256k1 private key whose pubkey is registered in IssuerRegistry.
# SECURITY: Never expose this in client code
# Leave blank to use the demo issuer key (logged loudly on startup)
ISSUER_PRIVATE_KEY=
ISSUER_SECRET_KEY=
SIGNER_SECRET_KEY=

# -----------------------------------------------------------------------------
# Deployed Contract IDs
# -----------------------------------------------------------------------------
# Fill in after running scripts/deploy.sh

# [PUBLIC] [OPTIONAL] Issuer registry contract ID
NEXT_PUBLIC_ISSUER_REGISTRY_ID=

# [PUBLIC] [OPTIONAL] Credential verifier contract ID
NEXT_PUBLIC_CREDENTIAL_VERIFIER_ID=

# [PUBLIC] [OPTIONAL] Proof registry contract ID
NEXT_PUBLIC_PROOF_REGISTRY_ID=
NEXT_PUBLIC_PROOF_REGISTRY_CONTRACT_ID=

# [SERVER] [OPTIONAL] Proof registry contract ID (server-side SDK access)
PROOF_REGISTRY_ID=
PROOF_REGISTRY_CONTRACT_ID=

# [PUBLIC] [OPTIONAL] Gated pool contract ID
NEXT_PUBLIC_GATED_POOL_ID=

# -----------------------------------------------------------------------------
# StellarCred SDK Configuration (Server-side)
# -----------------------------------------------------------------------------

# [SERVER] [OPTIONAL] Registry ID for SDK server-side operations
STELLARCRED_REGISTRY_ID=

# [SERVER] [OPTIONAL] RPC URL for SDK server-side operations
STELLARCRED_RPC_URL=

# -----------------------------------------------------------------------------
# Persona KYC (Identity Verification)
# -----------------------------------------------------------------------------
# Optional — unset = demo mode, identity verification skipped
# Create templates at https://app.withpersona.com → Inquiries → Templates
# Government ID flow — issues kyc, age, and jurisdiction credentials.
# If PERSONA_API_KEY is set, PERSONA_KYC_TEMPLATE_ID must also be set.

# [SERVER] [OPTIONAL] Persona API key
PERSONA_API_KEY=

# [SERVER] [OPTIONAL] Persona KYC template ID
PERSONA_KYC_TEMPLATE_ID=

# [SERVER] [OPTIONAL] Persona webhook secret for verifying callback HMAC signatures
PERSONA_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Plaid Balance Attestation
# -----------------------------------------------------------------------------
# Optional — unset = mock mode, balance always passes
# Get credentials at https://dashboard.plaid.com — use sandbox for testing.
# If any one is set, all three (CLIENT_ID, SECRET, ACCESS_TOKEN) must be set.

# [SERVER] [OPTIONAL] Plaid client ID
PLAID_CLIENT_ID=

# [SERVER] [OPTIONAL] Plaid secret
PLAID_SECRET=

# [SERVER] [OPTIONAL] Plaid access token for balance checks
PLAID_ACCESS_TOKEN=

# [PUBLIC] Plaid environment
# Options: sandbox | development | production
# Default: sandbox
PLAID_ENV=sandbox

# -----------------------------------------------------------------------------
# Operations & Monitoring
# -----------------------------------------------------------------------------

# [SERVER] Log level for structured logging
# Options: fatal | error | warn | info | debug | trace
# Default: info
LOG_LEVEL=info

# [SERVER] [OPTIONAL] Production origin for CORS on /api/* routes
# Set to your deployed app URL (e.g. https://stellarcred.xyz)
# Falls back to http://localhost:3000 in dev if unset;
# must be set correctly in production or CORS will be ineffective.
APP_ORIGIN=

# [SERVER] [OPTIONAL] TTL for idempotency keys in seconds
# Used to prevent duplicate credential issuance
# Default: 86400 (24 hours)
IDEMPOTENCY_TTL_SECONDS=86400

# -----------------------------------------------------------------------------
# Development & Testing
# -----------------------------------------------------------------------------

# [SERVER] [OPTIONAL] Port for the development server
# Default: 4100 in app, 3100 in tests
PORT=4100

# [SERVER] [OPTIONAL] Set to "true" to enable bundle analysis
# Used with @next/bundle-analyzer
ANALYZE=false

# [SERVER] [OPTIONAL] Base URL for Playwright E2E tests
# Default: http://localhost:${PORT}
PLAYWRIGHT_BASE_URL=

# [SERVER] Set automatically by CI systems (GitHub Actions, etc.)
# Used to enable CI-specific behaviors (test retries, reporters)
# Do not set manually
CI=false
cat > .env.example << 'EOF'
# =============================================================================
# StellarCred Environment Configuration (ROOT)
# =============================================================================
# NOTE: This file documents variables used by the root-level services
# (indexer, scripts, etc.).
#
# For the Next.js frontend, see frontend/.env.example — that file documents
# all NEXT_PUBLIC_* and server-side variables used by the frontend app.
#
# Do not let these two files drift: if you add a new env var to one source
# tree, add it to the corresponding .env.example file.
# =============================================================================

# -----------------------------------------------------------------------------
# Indexer / Root Services
# -----------------------------------------------------------------------------

# Database driver for the indexer (sqlite | postgres)
DB_DRIVER=sqlite

# SQLite database path (used when DB_DRIVER=sqlite)
SQLITE_PATH=./data/indexer.db

# PostgreSQL connection string (used when DB_DRIVER=postgres)
DATABASE_URL=postgres://indexer:indexer@localhost:5432/indexer

# Stellar RPC endpoint for the indexer
RPC_URL=https://soroban-testnet.stellar.org

# Stellar network passphrase
NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Proof registry contract ID (deployed via scripts/deploy.sh)
PROOF_REGISTRY_CONTRACT_ID=

# Poll interval for the indexer (milliseconds)
POLL_INTERVAL_MS=5000

# Event page limit for the indexer
EVENT_PAGE_LIMIT=100

# Starting ledger for the indexer
START_LEDGER=0

# Port for the indexer service
PORT=4100
EOF