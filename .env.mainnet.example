# =============================================================================
# StellarCred Mainnet Environment Template (Issue #408)
# =============================================================================
# Copy to frontend/.env.local (frontend vars) and root .env (indexer vars).
#
# RULE: ONE selector drives everything. Set NEXT_PUBLIC_STELLAR_NETWORK /
# STELLAR_NETWORK to "mainnet" and let the presets supply RPC + passphrase.
# Only override RPC_URL / NETWORK_PASSPHRASE if you run a custom endpoint —
# and never mix artifacts from different networks: both the app
# (lib/network-check.ts) and the indexer (src/networks.ts preflight) fail
# loudly on mixed-network config at startup.
#
# CONTRACT IDs MUST be re-deployed per network. A testnet contract ID used
# with a mainnet passphrase will fail (contract not found) — the preflight
# catches passphrase/RPC mismatches; contract IDs are validated on-chain.
# =============================================================================

# ── Frontend (frontend/.env.local) ───────────────────────────────────────────

# [PUBLIC] Single network selector: testnet | mainnet | futurenet
NEXT_PUBLIC_STELLAR_NETWORK=mainnet

# [PUBLIC] Soroban RPC endpoint — OPTIONAL, preset supplies the mainnet URL
# (https://soroban.stellar.org). Only set for custom/private endpoints.
NEXT_PUBLIC_RPC_URL=

# [PUBLIC] Network passphrase — OPTIONAL, preset supplies the mainnet value
# ("Public Global Stellar Network ; September 2015").
NEXT_PUBLIC_NETWORK_PASSPHRASE=

# [PUBLIC] Deployed MAINNET contract IDs (re-run scripts/deploy.sh on mainnet)
NEXT_PUBLIC_ISSUER_REGISTRY_ID=
NEXT_PUBLIC_CREDENTIAL_VERIFIER_ID=
NEXT_PUBLIC_PROOF_REGISTRY_ID=
NEXT_PUBLIC_GATED_POOL_ID=

# [SERVER] Mainnet issuer signing key — never reuse the testnet key in prod
ISSUER_PRIVATE_KEY=

# [SERVER] Plaid environment must move to production for mainnet attestations
PLAID_ENV=production

# ── Indexer (root .env) ─────────────────────────────────────────────────────

# Single network selector — must match the frontend selector
STELLAR_NETWORK=mainnet

# OPTIONAL overrides — presets supply mainnet Horizon/RPC/passphrase:
# HORIZON_URL=https://horizon.stellar.org
# RPC_URL=https://soroban.stellar.org
# NETWORK_PASSPHRASE=Public Global Stellar Network ; September 2015

# MAINNET ProofRegistry contract ID (re-deployed; not the testnet ID)
PROOF_REGISTRY_CONTRACT_ID=

# Mainnet finality: consider raising FINALITY_LAG (ledgers) for safety
FINALITY_LAG=6

# CORS: set to your production frontend origin(s), comma-separated
CORS_ALLOWED_ORIGINS=https://stellarcred.xyz
